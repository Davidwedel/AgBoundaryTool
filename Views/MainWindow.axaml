<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgBoundaryTool.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="AgBoundaryTool.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AgBoundaryTool - Field Boundary Manager"
        Width="1200" Height="800">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Buttons -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
            <StackPanel Spacing="10">

                <Button Command="{Binding OpenGpsConnectionDialogCommand}"
                        Height="60" Width="60"
                        ToolTip.Tip="GPS Connection">
                    <Image Source="/btnImages/AgIO.png" Stretch="Uniform"/>
                </Button>

                <Button Command="{Binding OpenGpsSimulatorDialogCommand}"
                        Height="60" Width="60"
                        ToolTip.Tip="GPS Simulator">
                    <TextBlock Text="SIM" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <Button Command="{Binding OpenFieldManagementDialogCommand}"
                        Height="60" Width="60"
                        ToolTip.Tip="Field Management">
                    <Image Source="/btnImages/FileExisting.png" Stretch="Uniform"/>
                </Button>

                <Button Command="{Binding OpenBoundaryRecordingDialogCommand}"
                        Height="60" Width="60"
                        ToolTip.Tip="Boundary Recording">
                    <Image Source="/btnImages/Boundary.png" Stretch="Uniform"/>
                </Button>

                <Button Command="{Binding OpenBoundaryModifyDialogCommand}"
                        Height="60" Width="60"
                        ToolTip.Tip="Notch/Bulge - Modify Boundaries">
                    <TextBlock Text="NOTCH&#x0a;BULGE" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </Button>

                <Button Command="{Binding OpenFlagManagementDialogCommand}"
                        Height="60" Width="60"
                        ToolTip.Tip="Flags">
                    <Image Source="/btnImages/FlagRed.png" Stretch="Uniform"/>
                </Button>

                <!-- Separator -->
                <Border Height="2" Background="LightGray" Margin="0,5"/>

                <!-- Undo Button -->
                <Button Command="{Binding UndoCommand}"
                        Height="60" Width="60"
                        IsEnabled="{Binding CanUndo}"
                        ToolTip.Tip="{Binding UndoDescription}">
                    <TextBlock Text="UNDO" FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Redo Button -->
                <Button Command="{Binding RedoCommand}"
                        Height="60" Width="60"
                        IsEnabled="{Binding CanRedo}"
                        ToolTip.Tip="{Binding RedoDescription}">
                    <TextBlock Text="REDO" FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- History Button -->
                <Button Command="{Binding OpenHistoryDialogCommand}"
                        Height="60" Width="60"
                        ToolTip.Tip="View History">
                    <TextBlock Text="HISTORY" FontSize="10" FontWeight="Bold"
                               TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

            </StackPanel>
        </Border>

        <!-- Right Panel: Boundary Visualization -->
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="10,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Visualization Header -->
                <Border Grid.Row="0" Background="#E0E0E0" Padding="10" BorderBrush="Gray" BorderThickness="0,0,0,1">
                    <TextBlock Text="Boundary Visualization" FontWeight="Bold" FontSize="16"/>
                </Border>

                <!-- Boundary visualization control -->
                <Border Grid.Row="1" Background="Black" Margin="10" ClipToBounds="True" Name="VisualizationBorder">
                    <!-- Custom control will be created in code-behind -->
                </Border>
            </Grid>
        </Border>

    </Grid>

</Window>
