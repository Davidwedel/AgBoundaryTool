<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgBoundaryTool.ViewModels"
        x:Class="AgBoundaryTool.Views.Dialogs.FieldManagementDialog"
        x:DataType="vm:MainWindowViewModel"
        Title="Field Management"
        Width="450" Height="350"
        CanResize="false">

    <Border BorderBrush="DarkBlue" BorderThickness="2" CornerRadius="5" Padding="10" Margin="10">
        <StackPanel Spacing="8">
            <TextBlock Text="Field Management" FontWeight="Bold" FontSize="16"/>

            <StackPanel Spacing="5">
                <TextBlock Text="Field Name:"/>
                <TextBox Text="{Binding FieldName}"/>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="Field Directory:"/>
                <TextBox Text="{Binding FieldDirectory}" IsReadOnly="True"
                         ToolTip.Tip="{Binding FieldDirectory}"/>
            </StackPanel>

            <Button Content="Create New Field"
                    Command="{Binding CreateNewFieldCommand}"
                    IsEnabled="{Binding IsConnected}"/>

            <Button Content="Load Field"
                    Command="{Binding LoadFieldCommand}"/>

            <Button Content="Save As..."
                    Command="{Binding SaveFieldAsCommand}"/>

            <Button Content="Close Field"
                    Command="{Binding CloseFieldCommand}"/>

            <Button Content="Close" HorizontalAlignment="Right"
                    Click="CloseButton_Click" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
