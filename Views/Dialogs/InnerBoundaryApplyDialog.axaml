<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgBoundaryTool.ViewModels"
        x:Class="AgBoundaryTool.Views.Dialogs.InnerBoundaryApplyDialog"
        x:DataType="vm:MainWindowViewModel"
        Title="Apply Inner Boundary Modification"
        Width="450" Height="400"
        CanResize="false">

    <Border BorderBrush="Red" BorderThickness="2" CornerRadius="5" Padding="10" Margin="10">
        <StackPanel Spacing="10">
            <TextBlock Text="Apply Inner Boundary Modification" FontWeight="Bold" FontSize="16"/>

            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Gray">
                Review your recorded path and apply it to the inner boundary, or cancel to discard.
            </TextBlock>

            <!-- Modification Status -->
            <Border Background="#F0F0F0" Padding="10" CornerRadius="3">
                <StackPanel Spacing="5">
                    <TextBlock Text="{Binding NotchPointCount, StringFormat='Points Recorded: {0}'}"
                               FontSize="13"/>
                    <TextBlock Text="{Binding StatusText}"
                               TextWrapping="Wrap"
                               FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Warning if invalid -->
            <Border Background="#FFF3CD" BorderBrush="#FFA500" BorderThickness="1"
                    Padding="8" CornerRadius="3"
                    IsVisible="{Binding !CanApplyNotch}">
                <StackPanel Spacing="3">
                    <TextBlock Text="⚠ Cannot Apply Modification" FontWeight="Bold" FontSize="12" Foreground="#856404"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#856404">
                        The path must cross the inner boundary at least twice.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Spacing="8" Margin="0,10,0,0">
                <Button Content="Apply Modification"
                        Click="ApplyButton_Click"
                        IsEnabled="{Binding CanApplyNotch}"
                        Background="Green" Foreground="White"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        FontSize="14" FontWeight="Bold"/>

                <Button Content="Cancel - Discard Changes"
                        Click="CancelButton_Click"
                        Background="DarkRed" Foreground="White"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        FontSize="14"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
