<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgBoundaryTool.ViewModels"
        x:Class="AgBoundaryTool.Views.Dialogs.InnerBoundaryModifyDialog"
        x:DataType="vm:MainWindowViewModel"
        Title="Modify Inner Boundary"
        Width="450" Height="350"
        CanResize="false">

    <Border BorderBrush="Red" BorderThickness="2" CornerRadius="5" Padding="10" Margin="10">
        <StackPanel Spacing="10">
            <TextBlock Text="Modify Inner Boundary" FontWeight="Bold" FontSize="16"/>

            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Gray">
                Select an inner boundary and operation type to modify.
            </TextBlock>

            <!-- Inner Boundary Selection -->
            <Border Background="#F0F0F0" Padding="10" CornerRadius="3">
                <StackPanel Spacing="5">
                    <TextBlock Text="Select Inner Boundary:" FontWeight="Bold" FontSize="13"/>
                    <ComboBox Name="InnerBoundaryComboBox"
                              ItemsSource="{Binding InnerBoundaryChoices}"
                              SelectedIndex="{Binding SelectedInnerBoundaryIndex}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Operation Selection -->
            <Border Background="#F0F0F0" Padding="10" CornerRadius="3">
                <StackPanel Spacing="5">
                    <TextBlock Text="Operation:" FontWeight="Bold" FontSize="13"/>

                    <RadioButton GroupName="Operation"
                                 IsChecked="{Binding IsInnerNotchOperation}"
                                 Content="Notch (Cut into inner boundary - makes hole smaller)"/>

                    <RadioButton GroupName="Operation"
                                 IsChecked="{Binding IsInnerBulgeOperation}"
                                 Content="Bulge (Expand inner boundary - makes hole bigger)"/>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Spacing="8" Margin="0,10,0,0">
                <Button Content="Start Recording"
                        Click="StartButton_Click"
                        IsEnabled="{Binding CanStartInnerModify}"
                        Background="Green" Foreground="White"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        FontSize="14" FontWeight="Bold"/>

                <Button Content="Cancel"
                        Click="CancelButton_Click"
                        Background="DarkRed" Foreground="White"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        FontSize="14"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
