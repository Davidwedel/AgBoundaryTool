<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgBoundaryTool.ViewModels"
        x:Class="AgBoundaryTool.Views.Dialogs.FieldSplitDialog"
        x:DataType="vm:MainWindowViewModel"
        Title="Split Field"
        Width="500" Height="620"
        CanResize="false">

    <Border BorderBrush="DarkBlue" BorderThickness="2" CornerRadius="5" Padding="10" Margin="10">
        <StackPanel Spacing="10">
            <TextBlock Text="Split Field" FontWeight="Bold" FontSize="16"/>

            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Gray">
                Split the current field into two new fields. The original field will be preserved.
            </TextBlock>

            <!-- Current Field Info -->
            <Border Background="#F0F0F0" Padding="10" CornerRadius="3">
                <StackPanel Spacing="3">
                    <TextBlock Text="{Binding FieldName, StringFormat='Current Field: {0}'}"
                               FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="{Binding BoundaryArea, StringFormat='Area: {0:F2} ha'}"
                               FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Split Method Selection -->
            <Border Background="#E8F4F8" Padding="10" CornerRadius="3">
                <StackPanel Spacing="5">
                    <TextBlock Text="Split Method:" FontWeight="Bold" FontSize="13"/>

                    <RadioButton GroupName="SplitMethod"
                                 IsChecked="{Binding IsSplitByOnePoint}"
                                 Content="One Point + Heading (split line from point in direction)"/>

                    <RadioButton GroupName="SplitMethod"
                                 IsChecked="{Binding IsSplitByTwoPoints}"
                                 Content="Two Points (split line connects two points)"/>
                </StackPanel>
            </Border>

            <!-- One Point Method Controls -->
            <Border Background="#F0F0F0" Padding="10" CornerRadius="3"
                    IsVisible="{Binding IsSplitByOnePoint}">
                <StackPanel Spacing="8">
                    <TextBlock Text="One Point + Heading Method:" FontWeight="Bold" FontSize="12"/>

                    <Button Content="Drop Point at Current Location"
                            Click="DropSplitPoint1_Click"
                            IsEnabled="{Binding IsConnected}"
                            Background="DarkGreen" Foreground="White"
                            Height="35"/>

                    <TextBlock Text="{Binding SplitPoint1Status}"
                               FontSize="11" Foreground="DarkGreen"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Heading (degrees):" VerticalAlignment="Center" FontSize="12"/>
                        <NumericUpDown Value="{Binding SplitHeading}"
                                       Minimum="0" Maximum="359"
                                       Width="100" Height="30"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Two Points Method Controls -->
            <Border Background="#F0F0F0" Padding="10" CornerRadius="3"
                    IsVisible="{Binding IsSplitByTwoPoints}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Two Points Method:" FontWeight="Bold" FontSize="12"/>

                    <Button Content="Drop First Point"
                            Click="DropSplitPoint1_Click"
                            IsEnabled="{Binding IsConnected}"
                            Background="DarkGreen" Foreground="White"
                            Height="35"/>

                    <TextBlock Text="{Binding SplitPoint1Status}"
                               FontSize="11" Foreground="DarkGreen"/>

                    <Button Content="Drop Second Point"
                            Click="DropSplitPoint2_Click"
                            IsEnabled="{Binding IsConnected}"
                            Background="DarkGreen" Foreground="White"
                            Height="35"/>

                    <TextBlock Text="{Binding SplitPoint2Status}"
                               FontSize="11" Foreground="DarkGreen"/>
                </StackPanel>
            </Border>

            <!-- New Field Names -->
            <Border Background="#FFF3CD" Padding="10" CornerRadius="3">
                <StackPanel Spacing="5">
                    <TextBlock Text="New Field Names:" FontWeight="Bold" FontSize="12"/>

                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Field A:" Width="60" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SplitFieldNameA}"
                                 Width="200" Height="30"
                                 Watermark="Enter name for first field"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Field B:" Width="60" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SplitFieldNameB}"
                                 Width="200" Height="30"
                                 Watermark="Enter name for second field"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Spacing="8" Margin="0,10,0,0">
                <Button Content="Split Field"
                        Click="SplitButton_Click"
                        IsEnabled="{Binding CanSplitField}"
                        Background="DarkBlue" Foreground="White"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        FontSize="14" FontWeight="Bold"/>

                <Button Content="Cancel"
                        Click="CancelButton_Click"
                        Background="DarkRed" Foreground="White"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        FontSize="14"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
