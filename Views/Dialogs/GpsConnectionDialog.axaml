<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgBoundaryTool.ViewModels"
        x:Class="AgBoundaryTool.Views.Dialogs.GpsConnectionDialog"
        x:DataType="vm:MainWindowViewModel"
        Title="GPS Connection"
        Width="400" Height="650"
        CanResize="false">

    <Border BorderBrush="DarkGreen" BorderThickness="2" CornerRadius="5" Padding="10" Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
            <TextBlock Text="GPS Connection" FontWeight="Bold" FontSize="16"/>

            <StackPanel Spacing="5">
                <TextBlock Text="Serial Port:"/>
                <Grid ColumnDefinitions="*,Auto">
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailablePorts}"
                              SelectedItem="{Binding SelectedPort}"/>
                    <Button Grid.Column="1" Content="↻"
                            Command="{Binding RefreshPortsCommand}"
                            Width="40" Margin="5,0,0,0"
                            ToolTip.Tip="Refresh ports"/>
                </Grid>
            </StackPanel>

            <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0" Content="Connect"
                        Command="{Binding ConnectGpsCommand}"
                        IsEnabled="{Binding !IsConnected}"
                        Margin="0,0,2.5,0"/>
                <Button Grid.Column="1" Content="Disconnect"
                        Command="{Binding DisconnectGpsCommand}"
                        IsEnabled="{Binding IsConnected}"
                        Margin="2.5,0,0,0"/>
            </Grid>

            <Border Background="#F0F0F0" Padding="8" CornerRadius="3">
                <StackPanel Spacing="3">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Latitude, StringFormat='Lat: {0:F6}°'}"/>
                    <TextBlock Text="{Binding Longitude, StringFormat='Lon: {0:F6}°'}"/>
                    <TextBlock Text="{Binding Altitude, StringFormat='Alt: {0:F1} m'}"/>
                    <TextBlock Text="{Binding Heading, StringFormat='Heading: {0:F1}°'}"/>
                    <TextBlock Text="{Binding Speed, StringFormat='Speed: {0:F1} m/s'}"/>
                    <TextBlock Text="{Binding SatelliteCount, StringFormat='Satellites: {0}'}"/>
                    <TextBlock Text="{Binding FixQuality, StringFormat='Fix Quality: {0}'}"/>
                </StackPanel>
            </Border>

            <!-- NTRIP Section -->
            <Border BorderBrush="DarkBlue" BorderThickness="1" CornerRadius="3" Padding="5" Margin="0,10,0,0">
                <StackPanel Spacing="5">
                    <Button Content="Ntrip" Command="{Binding ToggleNtripSettingsCommand}"
                            HorizontalAlignment="Stretch" Background="LightBlue"/>

                    <StackPanel Spacing="5" IsVisible="{Binding NtripSettingsVisible}">
                        <TextBlock Text="NTRIP Settings" FontWeight="SemiBold"/>

                        <StackPanel Spacing="3">
                            <TextBlock Text="Host:"/>
                            <TextBox Text="{Binding NtripHost}"/>
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <TextBlock Text="Port:"/>
                            <TextBox Text="{Binding NtripPort}"/>
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <TextBlock Text="Mount Point:"/>
                            <TextBox Text="{Binding NtripMountPoint}"/>
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <TextBlock Text="Username:"/>
                            <TextBox Text="{Binding NtripUsername}"/>
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <TextBlock Text="Password:"/>
                            <TextBox Text="{Binding NtripPassword}" PasswordChar="*"/>
                        </StackPanel>

                        <CheckBox Content="Use SSL/TLS (HTTPS)" IsChecked="{Binding NtripUseSsl}"/>

                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0" Content="Connect"
                                    Command="{Binding ConnectNtripCommand}"
                                    IsEnabled="{Binding !IsNtripConnected}"
                                    Margin="0,0,2.5,0"/>
                            <Button Grid.Column="1" Content="Disconnect"
                                    Command="{Binding DisconnectNtripCommand}"
                                    IsEnabled="{Binding IsNtripConnected}"
                                    Margin="2.5,0,0,0"/>
                        </Grid>

                        <TextBlock FontWeight="SemiBold">
                            <Run Text="NTRIP Status: "/>
                            <Run Text="{Binding IsNtripConnected}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Content="Close" HorizontalAlignment="Right"
                    Click="CloseButton_Click" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
