<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgBoundaryTool.ViewModels"
        x:Class="AgBoundaryTool.Views.Dialogs.BoundaryModifyDialog"
        x:DataType="vm:MainWindowViewModel"
        Title="Modify Boundary"
        Width="450" Height="480"
        CanResize="false">

    <Border BorderBrush="Purple" BorderThickness="2" CornerRadius="5" Padding="10" Margin="10">
        <StackPanel Spacing="10">
            <TextBlock Text="Modify Boundary" FontWeight="Bold" FontSize="16"/>

            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Gray">
                Select a boundary to modify, choose an operation (notch/bulge), then record your modification path.
            </TextBlock>

            <!-- Boundary Selection -->
            <Border Background="#F0F0F0" Padding="10" CornerRadius="3">
                <StackPanel Spacing="5">
                    <TextBlock Text="Select Boundary:" FontWeight="Bold" FontSize="13"/>
                    <ComboBox Name="BoundaryComboBox"
                              ItemsSource="{Binding BoundaryChoices}"
                              SelectedIndex="{Binding SelectedBoundaryIndex}"
                              HorizontalAlignment="Stretch"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray">
                        Click on a boundary in the visualization or select from dropdown above.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Operation Selection -->
            <Border Background="#F0F0F0" Padding="10" CornerRadius="3">
                <StackPanel Spacing="5">
                    <TextBlock Text="Operation:" FontWeight="Bold" FontSize="13"/>

                    <RadioButton GroupName="Operation"
                                 IsChecked="{Binding IsNotchOperation}"
                                 Content="Notch (Cut into boundary - reduce area)"/>

                    <RadioButton GroupName="Operation"
                                 IsChecked="{Binding IsBulgeOperation}"
                                 Content="Bulge (Expand boundary - increase area)"/>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Spacing="8" Margin="0,10,0,0">
                <!-- Trim button only for inner boundaries -->
                <Button Content="Trim to Outer Boundary"
                        Click="TrimButton_Click"
                        IsVisible="{Binding IsInnerBoundarySelected}"
                        IsEnabled="{Binding CanStartBoundaryModify}"
                        Background="DarkOrange" Foreground="White"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        FontSize="14" FontWeight="Bold"/>

                <Button Content="Start Recording (Notch/Bulge)"
                        Click="StartButton_Click"
                        IsEnabled="{Binding CanStartBoundaryModify}"
                        Background="Green" Foreground="White"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        FontSize="14" FontWeight="Bold"/>

                <Button Content="Cancel"
                        Click="CancelButton_Click"
                        Background="DarkRed" Foreground="White"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        FontSize="14"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
