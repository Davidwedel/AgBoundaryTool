<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgBoundaryTool.ViewModels"
        xmlns:dialogs="using:AgBoundaryTool.Views.Dialogs"
        x:Class="AgBoundaryTool.Views.Dialogs.BoundaryHistoryDialog"
        x:DataType="vm:MainWindowViewModel"
        Title="Boundary History"
        Width="550" Height="500"
        CanResize="true">

    <Border BorderBrush="DodgerBlue" BorderThickness="2" CornerRadius="5" Padding="10" Margin="10">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="5">
                <TextBlock Text="Boundary History" FontWeight="Bold" FontSize="16"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Gray">
                    View all boundary modifications. Click an entry to undo/redo to that point.
                </TextBlock>
            </StackPanel>

            <!-- History List -->
            <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="3" Margin="0,10,0,10">
                <ListBox Name="HistoryListBox"
                         SelectionChanged="HistoryListBox_SelectionChanged"
                         Background="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:HistoryDisplayEntry">
                            <Border Padding="10,8">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Current state indicator -->
                                    <TextBlock Grid.Column="0"
                                               Text="►"
                                               FontWeight="Bold"
                                               Foreground="Green"
                                               FontSize="14"
                                               Margin="0,0,8,0"
                                               IsVisible="{Binding IsCurrent}"/>

                                    <!-- Action description -->
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding ActionDescription}"
                                                   FontSize="13"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                                   FontSize="10"
                                                   Foreground="Gray"/>
                                    </StackPanel>

                                    <!-- State index -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Index, StringFormat='#{0}'}"
                                               FontSize="11"
                                               Foreground="Gray"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Spacing="8">
                <Grid ColumnDefinitions="*,10,*">
                    <Button Grid.Column="0"
                            Content="Undo"
                            Command="{Binding UndoCommand}"
                            IsEnabled="{Binding CanUndo}"
                            HorizontalAlignment="Stretch"
                            Height="35"
                            FontSize="13"/>

                    <Button Grid.Column="2"
                            Content="Redo"
                            Command="{Binding RedoCommand}"
                            IsEnabled="{Binding CanRedo}"
                            HorizontalAlignment="Stretch"
                            Height="35"
                            FontSize="13"/>
                </Grid>

                <Button Content="Close"
                        Click="CloseButton_Click"
                        HorizontalAlignment="Stretch"
                        Height="35"
                        FontSize="13"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
